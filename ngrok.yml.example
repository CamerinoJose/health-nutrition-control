# Example ngrok config for local development
#
# 1) Install ngrok and login/add token (once):
#    ngrok config add-authtoken <YOUR_TOKEN>
#
# 2) Copy this file to ngrok.yml (DO NOT COMMIT ngrok.yml)
#
# 3) Start tunnels:
#    ngrok start --all --config ngrok.yml
#
version: "2"

# Two tunnels: Web (Vite) and API (Go backend)
# Web -> http://localhost:5173
# API -> http://localhost:8080

tunnels:
  web:
    proto: http
    addr: 5173
  api:
    proto: http
    addr: 8080
