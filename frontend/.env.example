# Frontend Environment Variables - Development
# Copy this to .env.local (do not commit secrets)

# Backend API base URL.
# Preferred variable: VITE_BACKEND_URL
# Legacy alias (also supported): VITE_API_URL
# Examples:
# - Local API:  http://localhost:8080/api
# - ngrok API:  https://<API_DOMAIN>.ngrok-free.dev/api
# - Render:     https://health-nutrition-control.onrender.com/api
VITE_BACKEND_URL=http://localhost:8080/api

# Legacy alias (optional)
VITE_API_URL=

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Gemini API Key (Optional - for AI chat)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Environment
VITE_ENV=development
