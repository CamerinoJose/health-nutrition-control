# Backend Environment Variables - Example
# Copy this file to .env.local and fill in your values
# NEVER commit .env or .env.local to git!

# Server Configuration
PORT=8080
GIN_MODE=debug

# JWT Secret (required to start the backend)
# Generate a unique secret: openssl rand -base64 32
JWT_SECRET=

# Database Configuration
# PostgreSQL (obligatorio)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=bienestar
POSTGRES_HOST=localhost
POSTGRES_SSLMODE=disable

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id-from-console.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

# Gemini API (Optional - for AI features)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-pro

# Production URLs (when deployed)
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
